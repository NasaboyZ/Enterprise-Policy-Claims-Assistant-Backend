# Antwortgenerierung: groq (Standard), aion oder gemini
CHAT_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Optional: nur bei CHAT_PROVIDER=aion
AION_API_KEY=
AION_CHAT_MODEL=aion-labs/aion-2.0

# Dokumentensuche und Embeddings laufen lokal ohne API-Key.
# Google ist nur optional für Antworten mit CHAT_PROVIDER=gemini.
GOOGLE_API_KEY=
# Nur bei CHAT_PROVIDER=gemini für die Antworten verwendet
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite

FRAUD_THRESHOLD=0.5
ANONYMIZED_TELEMETRY=False
